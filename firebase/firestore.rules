rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function memberExists(familyId) { return signedIn() && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)); }
    function memberRole(familyId) { return get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role; }
    function isParent(familyId) { return memberExists(familyId) && memberRole(familyId) == 'parent'; }
    function isChild(familyId) { return memberExists(familyId) && memberRole(familyId) == 'child' && request.auth.token.firebase.sign_in_provider == 'anonymous'; }

    match /families/{familyId} {
      allow create: if signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com' && request.resource.data.keys().hasOnly(['ownerUid', 'name', 'createdAt']) && request.resource.data.ownerUid == request.auth.uid;
      allow read: if memberExists(familyId);
      allow update: if isParent(familyId) && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isParent(familyId) && resource.data.ownerUid == request.auth.uid;
    }

    match /families/{familyId}/members/{memberUid} {
      allow read: if memberExists(familyId);
      allow create: if signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com' && memberUid == request.auth.uid && request.resource.data.uid == memberUid && request.resource.data.role == 'parent' && get(/databases/$(database)/documents/families/$(familyId)).data.ownerUid == request.auth.uid;
      allow update: if isParent(familyId) && request.resource.data.uid == resource.data.uid && request.resource.data.role == resource.data.role;
      allow delete: if isParent(familyId) && memberUid != resource.data.uid;
    }

    match /families/{familyId}/invites/{inviteId} { allow read, create, update, delete: if false; }
    match /families/{familyId}/parentInvites/{inviteId} { allow read, create, update, delete: if false; }

    match /families/{familyId}/alerts/{alertId} {
      allow create: if isChild(familyId) && request.resource.data.keys().hasOnly(['childUid', 'ciphertext', 'schemaVersion', 'createdAt', 'expiresAt']) && request.resource.data.childUid == request.auth.uid && request.resource.data.ciphertext is string && request.resource.data.ciphertext.size() > 0 && request.resource.data.schemaVersion is int && request.resource.data.createdAt is timestamp && request.resource.data.expiresAt is timestamp;
      allow read: if isParent(familyId);
      allow update, delete: if false;
    }

    match /families/{familyId}/devices/{deviceUid} {
      allow read: if memberExists(familyId) && (isParent(familyId) || request.auth.uid == deviceUid);
      allow create: if isChild(familyId) && deviceUid == request.auth.uid && request.resource.data.uid == request.auth.uid && request.resource.data.memberUid == request.auth.uid;
      allow update: if isChild(familyId) && deviceUid == request.auth.uid &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.memberUid == resource.data.memberUid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['appInventory', 'appInventoryUpdatedAtMs', 'appInventoryUpdatedAt']);
      allow delete: if isParent(familyId);
    }

    match /families/{familyId}/commands/{commandId} {
      allow read: if isParent(familyId) || (isChild(familyId) && resource.data.targetDeviceUid == request.auth.uid);
      allow create, update, delete: if false;

      match /receipts/{deviceId} {
        allow read: if isParent(familyId);
        allow create: if isChild(familyId) && deviceId == request.auth.uid &&
          exists(/databases/$(database)/documents/families/$(familyId)/commands/$(commandId)) &&
          get(/databases/$(database)/documents/families/$(familyId)/commands/$(commandId)).data.targetDeviceUid == request.auth.uid &&
          request.resource.data.keys().hasOnly(['deviceId', 'memberId', 'action', 'acceptedAtMs', 'completedAtMs', 'success', 'reason']) &&
          request.resource.data.deviceId == deviceId &&
          request.resource.data.memberId is string &&
          request.resource.data.action is string &&
          request.resource.data.acceptedAtMs is int &&
          request.resource.data.completedAtMs is int &&
          request.resource.data.success is bool;
        allow update, delete: if false;
      }
    }
  }
}
